        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cardinal organ part that is a slender, more or less straight and stiff, fine-pointed, terminal or subterminal appendage of a glume, lemma, or palea.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FNA:glossary</oboInOwl:hasDbXref>
