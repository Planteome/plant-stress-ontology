        <oboInOwl:hasDbXref>APSNET:Wheat</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <rdfs:comment>Symptoms and signs: Distinct patches of stunted plants are indicative of Rhizoctonia root rot. Occasionally, seedlings are killed outright, resulting in bare patch. Under low magnification, root ends appear reddish brown and taper to a fine point, a diagnostic symptom known as spear tip. Usually only half of a lesion is evident at the end of a root.</rdfs:comment>
        <rdfs:label>wheat Rhizoctonia root rot fungal disease</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000738"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A wheat disease caused by a Rhizoctonia solani affecting a root system.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PSO_0000739 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PSO_0000739">
        <owl:equivalentClass>
            <owl:Class>
