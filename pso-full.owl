                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_29850"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A wheat disease caused by a Gaeumannomyces graminis affecting a plant structure.</obo:IAO_0000115>
        <dcterms:contributor>0000-0002-9013-5974</dcterms:contributor>
        <dcterms:contributor>0000-0003-1154-337X</dcterms:contributor>
        <dcterms:contributor>PSO:cooperl</dcterms:contributor>
        <oboInOwl:hasDbXref>APSNET:Wheat</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <rdfs:comment>Early stunting and foliar discoloration; limited tillering; bleached or straw-colored plants; limited formation of spikes; bleached spikes with shriveled kernels; dry rot of roots, crown, and basal culm tissue; shiny dark-brown to black surface mat of fungal tissue underneath leaf sheath at plant base; diseased plants easily pulled up from ground.</rdfs:comment>
        <rdfs:label>wheat take-all fungal disease</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000740"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A wheat disease caused by a Gaeumannomyces graminis affecting a plant structure.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PSO_0000741 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PSO_0000741">
