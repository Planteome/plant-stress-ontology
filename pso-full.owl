    <!-- http://purl.obolibrary.org/obo/PO_0004513 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0004513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0005848"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of secondary xylem (PO:0005848) that has as parts living secondary xylem parenchyma cells (PO:0004525).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>albura (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>液材、辺材 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0004513</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <rdfs:comment>Sapwood contains reserve materials and may function in the conduction of water and minerals (xylem sap (PO:0025539)). It is generally lighter colored than the heartwood (PO:0004512) and is located between the heartwood and the vascular cambium (PO:0005598) of a shoot axis (PO:0025029) or root (PO:0009005). Sapwood forms during a secondary xylem development stage (PO:0025427).</rdfs:comment>
        <rdfs:label>sapwood</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0004513"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A portion of secondary xylem (PO:0005848) that has as parts living secondary xylem parenchyma cells (PO:0004525).</owl:annotatedTarget>
