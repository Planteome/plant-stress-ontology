    <!-- http://purl.obolibrary.org/obo/RO_0002566 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002566">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002506"/>
