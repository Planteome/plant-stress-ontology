        <oboInOwl:id>PO:0009051</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Poaceae"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment>It consists of one to many closely-packed spikelet florets (PO:0009082) and associated glumes (PO:0009039).</rdfs:comment>
        <rdfs:label>spikelet</rdfs:label>
