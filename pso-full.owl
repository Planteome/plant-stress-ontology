    <!-- http://purl.obolibrary.org/obo/PO_0025277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025202"/>
        <rdfs:subClassOf>
