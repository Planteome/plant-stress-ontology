    <!-- http://purl.obolibrary.org/obo/PO_0025007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025497"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A collective plant structure (PO:0025497) that is a proper part of a whole plant (PO:0000003), and is composed of two or more adjacent plant organs (PO:0009008) and the associated portions of plant tissue (PO:0009007).</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-02-09T04:12:11Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PO_GIT:63</oboInOwl:hasDbXref>
