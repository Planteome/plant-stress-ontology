            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A reproductive shoot system (PO:0025082) that has as parts all of the shoot axes (PO:0025029) and flowers (PO:0009046; must have two or more) distal to the most distal leaf (PO:0009025).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>PO:0009048</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>PO:0009050</oboInOwl:hasAlternativeId>
