        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0005597"/>
        <obo:IAO_0000115>A cambium (PO:0005597) that is located between and gives rise to secondary xylem (PO:0005848) and secondary phloem (PO:0005043).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:437</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cambium vascular (Spanish, exact)</oboInOwl:hasExactSynonym>
