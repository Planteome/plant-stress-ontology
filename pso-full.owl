    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0005352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009015"/>
        <obo:IAO_0000115>A portion of vascular tissue (PO:0009015) that has as part one or more tracheary elements (PO:0000290).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:434</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>portion of xylem tissue (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>xilema (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>木質部 (Japanese, exact)</oboInOwl:hasExactSynonym>
