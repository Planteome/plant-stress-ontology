        <oboInOwl:hasAlternativeId>PO:0006476</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>PO_GIT:255</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:296</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>saco pol&amp;#237nico (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>花粉のう (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Poaceae microsporangium (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Zea microsporangium (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>anther lobe (narrow)</oboInOwl:hasNarrowSynonym>
