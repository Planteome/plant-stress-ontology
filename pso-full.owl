            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A wheat disease caused by a Typhula affecting a plant structure.</obo:IAO_0000115>
        <dcterms:contributor>0000-0002-9013-5974</dcterms:contributor>
        <dcterms:contributor>PSO:cooperl</dcterms:contributor>
        <oboInOwl:hasDbXref>APSNET:Wheat</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Gray snow mold</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Typhula blight</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <rdfs:comment>Symptoms and signs: Immediately following snow melt, foliage of plants with speckled snow mold is covered with a dense network of light-colored mycelium. Numerous dark-colored sclerotia become visible after foliage is exposed and dries for a few days. Sclerotia may be partially embeded in leaf tissue or scattered on the surface, giving plants a speckled appearance.</rdfs:comment>
        <rdfs:label>wheat speckled snow mold fungal disease</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000741"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A wheat disease caused by a Typhula affecting a plant structure.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


