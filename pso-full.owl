            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A wheat disease caused by a Barley yellow dwarf virus affecting a vascular leaf.</obo:IAO_0000115>
        <dcterms:contributor>0000-0002-9013-5974</dcterms:contributor>
        <dcterms:contributor>PSO:cooperl</dcterms:contributor>
        <oboInOwl:hasDbXref>APSNET:Wheat</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>WBYDV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cereal yellow dwarf</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <rdfs:comment>Symptoms: The quintessential symptoms are yellowing of leaves, especially the flag leaves and the shortening of internodes, resulting in a yellowed, dwarf plant. However, the discoloration can range across greens, yellows, oranges, reds, purples, and browns.</rdfs:comment>
        <rdfs:label>wheat barley yellow dwarf viral disease</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000744"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A wheat disease caused by a Barley yellow dwarf virus affecting a vascular leaf.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


