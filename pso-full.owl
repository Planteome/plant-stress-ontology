                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_77105"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A wheat disease caused by a Sclerotinia borealis affecting a whole plant.</obo:IAO_0000115>
        <dcterms:contributor>0000-0002-9013-5974</dcterms:contributor>
        <dcterms:contributor>PSO:cooperl</dcterms:contributor>
        <oboInOwl:hasDbXref>APSNET:Wheat</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Snow scald</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <rdfs:comment>Symptoms and signs: In the spring, dead leaves and plants are gray and thready. Numerous black, irregularly shaped sclerotia are usually present in and on diseased tissues.</rdfs:comment>
        <rdfs:label>wheat Sclerotinia snow mold fungal disease</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000739"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A wheat disease caused by a Sclerotinia borealis affecting a whole plant.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


