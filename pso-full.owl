        <oboInOwl:hasRelatedSynonym>setae (related, plural)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0025349</oboInOwl:id>
        <rdfs:comment>Found in a spikelet of Poaceae. Sometimes the awn is a continuation of the bearing structure&apos;s central primary vein.</rdfs:comment>
        <rdfs:label>awn</rdfs:label>
    </owl:Class>
    <owl:Axiom>
