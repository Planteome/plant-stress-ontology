                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0001097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sporophyte development stage (PO:0028002) that occurs during the interval between the first division of a plant zygote (PO:0000423) and the formation of a sporangium (PO:0025094).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GRO:0007139</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:395</oboInOwl:hasDbXref>
