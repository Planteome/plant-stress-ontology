        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025431</oboInOwl:id>
        <rdfs:comment>This is the region where you have the maximum concentration of auxin in the SAM (at least in a few species that have been studied).</rdfs:comment>
        <rdfs:label>vascular leaf anlagen</rdfs:label>
    </owl:Class>
    <owl:Axiom>
