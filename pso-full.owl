    <!-- http://purl.obolibrary.org/obo/PO_0009011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025131"/>
        <obo:IAO_0000115>A plant anatomical entity (PO:0025131) that is, or was, part of a plant, or was derived from a part of a plant.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:57</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>estructura vegetal (Spanish, exact)</oboInOwl:hasExactSynonym>
