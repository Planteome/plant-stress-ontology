    <!-- http://purl.obolibrary.org/obo/PO_0025042 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0004547"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tuber axillary vegetative bud that is part of a subterranean tuber.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-05-26T08:18:09Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>eye (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>tuber eye (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>PO_GIT:102</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>yema vegetativa axilar de tub&amp;#233rculo subterr&amp;#225neo (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>地下塊茎腋栄養芽 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>potato eye (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>swollen eye (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025042</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Potato"/>
        <rdfs:comment>A structure on the tuber surface that can sprout. In potatoes, axillary vegetative buds (eyes) can determine processing quality. Scale that the breeders use to rate the buds/sprouts of tubers: 1. none, 2. swollen eye, 3. sprout ca. 1/4 inch, 4. sprout ca. 1/2 inch, 5. sprout ca. 1 inch, 6. sprout ca. 2 inch, 7. sprout ca. 3 inch, 8. new top growth, 9. chain tubers.</rdfs:comment>
        <rdfs:label>subterranean tuber axillary vegetative bud</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0025042"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A tuber axillary vegetative bud that is part of a subterranean tuber.</owl:annotatedTarget>
