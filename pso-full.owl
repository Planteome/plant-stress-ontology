                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://purl.obolibrary.org/obo/GO_0003674"/>
                        <swrl:argument1 rdf:resource="urn:swrl#y"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
