            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A reproductive shoot system (PO:0025082) that is the ultimate and congested, higher order inflorescence axis (PO:0009081) of the grasses.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:383</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:71</oboInOwl:hasDbXref>
