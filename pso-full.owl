    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025082"/>
        <obo:IAO_0000115>A reproductive shoot system (PO:0025082) that is a second order inflorescence (PO:0025240), or higher, in which the inflorescence branch (PO:0009081) bears two or more flowers (PO:0009046), but is not elongated.</obo:IAO_0000115>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-07-07T10:52:27Z</oboInOwl:creation_date>
