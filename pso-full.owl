        <owl:annotatedTarget>A wheat disease caused by a Tilletia controversa affecting a plant structure.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


