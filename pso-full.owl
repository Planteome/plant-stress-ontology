            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A plant organ (PO:0009008) that has as parts a nucellus (PO:0020020) in which a female gametophyte (PO:0025279) is located, one or two integuments (PO:0020021), and a funicle (PO:0020006).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>PO:0006457</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>PO:0006491</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>PO_GIT:464</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:70</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>&amp;#243vulo vegetal (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>胚珠 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Poaceae ovule (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Zea ovule (narrow)</oboInOwl:hasNarrowSynonym>
