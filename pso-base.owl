                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>A wheat disease caused by a Bipolaris sorokiniana affecting a plant structure.</obo:IAO_0000115>
        <dcterms:contributor>0000-0002-9013-5974</dcterms:contributor>
        <dcterms:contributor>0000-0003-1154-337X</dcterms:contributor>
        <dcterms:contributor>PSO:cooperl</dcterms:contributor>
        <oboInOwl:hasDbXref>APSNET:Wheat</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <rdfs:comment>Small dark-brown lesions that elongate into blotches; dead leaves; shrivelled grain with black point; staining of embryo end of grain.</rdfs:comment>
        <rdfs:label>wheat spot blotch fungal disease</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000743"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A wheat disease caused by a Bipolaris sorokiniana affecting a plant structure.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


