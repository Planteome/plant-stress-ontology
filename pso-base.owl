    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/pso/pso-base.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/pso/releases/2025-12-15/pso-base.owl"/>
        <dce:type rdf:resource="http://purl.obolibrary.org/obo/IAO_8000001"/>
        <dcterms:description>An ontology describing biotic and abiotic plant stresses.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title>Plant Stress Ontology</dcterms:title>
        <oboInOwl:default-namespace>plant_stress_ontology</oboInOwl:default-namespace>
        <owl:versionInfo>2025-12-15</owl:versionInfo>
    </owl:Ontology>
    


