        <owl:annotatedTarget>A wheat disease caused by a Ceratobasidium cereale affecting a plant structure.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


