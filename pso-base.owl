                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PSO_0000013"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4565"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004025"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009025"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0014001"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_34373"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>A wheat disease caused by a Blumeria graminis affecting a vascular leaf.</obo:IAO_0000115>
        <dcterms:contributor>0000-0002-9013-5974</dcterms:contributor>
        <dcterms:contributor>PSO:cooperl</dcterms:contributor>
        <oboInOwl:hasDbXref>APSNET:Wheat</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <rdfs:comment>Symptoms and signs: effuse patches (colonies) of cottony mycelium and conidia on the surface of plant, initially white and sporulating and late turning gray brown. As the powdery mildew colonies mature, the fungus produses cleiostothesia as distinct as brown black dots.</rdfs:comment>
        <rdfs:label>wheat powdery mildew fungal disease</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000732"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A wheat disease caused by a Blumeria graminis affecting a vascular leaf.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PSO_0000733 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PSO_0000733">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PSO_0000013"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4565"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004025"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009025"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0014001"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_1047171"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>A wheat disease caused by a Zymoseptoria tritici affecting a vascular leaf.</obo:IAO_0000115>
        <dcterms:contributor>0000-0002-9013-5974</dcterms:contributor>
        <dcterms:contributor>PSO:cooperl</dcterms:contributor>
        <oboInOwl:hasDbXref>APSNET:Wheat</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <rdfs:comment>Symptoms and signs: lessions on leaves re broadly elliptical with a tan center and usually have a distinct yellow margin. Pycinia are readily visible as small, black specks in the necrotic ares of the lession.</rdfs:comment>
        <rdfs:label>wheat Septoria tritici blotch fungal disease</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000733"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A wheat disease caused by a Zymoseptoria tritici affecting a vascular leaf.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AUTO:patterns/disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PSO_0000734 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PSO_0000734">
