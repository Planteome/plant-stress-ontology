                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>A wheat disease caused by a Ceratobasidium cereale affecting a plant structure.</obo:IAO_0000115>
        <dcterms:contributor>0000-0002-9013-5974</dcterms:contributor>
        <dcterms:contributor>0000-0003-1154-337X</dcterms:contributor>
        <dcterms:contributor>PSO:cooperl</dcterms:contributor>
        <oboInOwl:hasDbXref>APSNET:Wheat</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>bare patch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <rdfs:comment>Bare patches in field; areas of uneven plant height; stunted plants; reduced root mass with pinched or constricted appearance; fine, sharp-looking, red-brown points on roots</rdfs:comment>
        <rdfs:label>wheat sharp eyespot fungal disease</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000742"/>
