    <!-- http://purl.obolibrary.org/obo/PSO_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PSO_0000011">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000016"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_33090"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PSO_0000001"/>
        <obo:IAO_0000115>A plant stress (PSO:0000001) caused by exposure to a biological stress causal agent.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PSO:0000011</oboInOwl:id>
        <rdfs:comment>Causal agents of biological plant stresses include fungi, bacteria, oomycetes, and viruses, as well as animals and other plants.</rdfs:comment>
        <rdfs:label xml:lang="en">biotic plant stress</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PSO_0000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PSO_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PSO_0000001"/>
        <obo:IAO_0000115>A plant stress (PSO:0000001) caused by exposure to an abiotic causal agent.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PSO:0000012</oboInOwl:id>
        <rdfs:comment>Abiotic stress causal agents can include chemicals or physical agents such as temperature, radiation or drought.</rdfs:comment>
        <rdfs:label xml:lang="en">abiotic plant stress</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
