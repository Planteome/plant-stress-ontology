    <!-- http://purl.obolibrary.org/obo/PSO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PSO_0000001">
        <obo:IAO_0000115 xml:lang="en">A biological process of some plant structure (PO:0009011) caused by exposure to some causal agent.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PSO:0000001</oboInOwl:id>
        <rdfs:label xml:lang="en">plant stress</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A biological process of some plant structure (PO:0009011) caused by exposure to some causal agent.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSO:cooperl</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PSO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PSO_0000004">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PSO_0000011"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/PSO_1000001"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009011"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/PSO_1000002"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_33208"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_33090"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PSO_0000011"/>
        <obo:IAO_0000115>A biotic plant stress (PSO:0000011) which is damage caused by the exposure to an animal.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>plant_stress_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PSO:0000004</oboInOwl:id>
        <rdfs:comment>Plants may be damaged by various animals such as arachnids (mites and spiders), insects, birds, rodents, nematodes, mollusks, or herbivores.</rdfs:comment>
        <rdfs:label xml:lang="en">plant animal damage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PSO_0000004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A biotic plant stress (PSO:0000011) which is damage caused by the exposure to an animal.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSO:cooperl</oboInOwl:hasDbXref>
    </owl:Axiom>
    


