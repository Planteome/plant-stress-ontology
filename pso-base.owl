        <obo:IAO_0000115>A wheat disease caused by a Tilletia caries or a Tilletia laevis affecting a spike inflorescence or a caryopsis fruit.</obo:IAO_0000115>
        <dcterms:contributor>0000-0002-9013-5974</dcterms:contributor>
        <dcterms:contributor>0000-0003-1154-337X</dcterms:contributor>
